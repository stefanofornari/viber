<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.SplitMenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ste.ai.viber.cli.DevModeController">
   <children>
      <ScrollPane fitToWidth="true" prefHeight="400.0" prefWidth="600.0">
         <content>
            <StackPane fx:id="conversationContainer" />
         </content>
      </ScrollPane>
      <TextArea fx:id="inputText" promptText="Enter message text..." prefRowCount="3" wrapText="true" />
      <HBox spacing="10" alignment="CENTER_LEFT">
         <children>
            <Button fx:id="addChatButton" text="Add Chat" />
            <Button fx:id="addReplyButton" text="Add Reply" />
            <Button fx:id="addThoughtButton" text="Add Thought" />
            <Button fx:id="addToolExecutionButton" text="Add Tool Execution" />
            <Button fx:id="addToolReplyButton" text="Add Tool Reply" />
            <Button fx:id="addErrorButton" text="Add Error" />
            <SplitMenuButton fx:id="addAskToolMenuButton" text="Add AskTool">
               <items>
                  <MenuItem fx:id="askQuestionMenuItem" text="AskQuestion" onAction="#handleAddAskQuestion" />
                  <MenuItem fx:id="askSingleChoiceMenuItem" text="AskSingleChoice" onAction="#handleAddAskSingleChoice" />
                  <MenuItem fx:id="askMultipleChoiceMenuItem" text="AskMultipleChoice" onAction="#handleAddAskMultipleChoice" />
                  <MenuItem fx:id="askConfirmationMenuItem" text="AskConfirmation" onAction="#handleAddAskConfirmation" />
               </items>
            </SplitMenuButton>
         </children>
      </HBox>
   </children>
</VBox>
