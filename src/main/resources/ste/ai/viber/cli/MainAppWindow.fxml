<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import ste.ai.viber.renderer.GUIRenderer?>

<VBox fx:id="root" spacing="10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ste.ai.viber.cli.MainAppController">
    <children>
        <MenuBar>
            <menus>
                <Menu text="Actor">
                    <items>
                        <CheckMenuItem fx:id="fxActorItem" text="Manual" selected="true" />
                        <CheckMenuItem fx:id="langChain4jActorItem" text="LLM" />
                        <CheckMenuItem fx:id="scopeAgentItem" text="Scope" />
                        <CheckMenuItem fx:id="storyAgentItem" text="Story" />
                        <CheckMenuItem fx:id="codingActorItem" text="Coding" />
                        <SeparatorMenuItem />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <SplitPane dividerPositions="0.75" orientation="VERTICAL" VBox.vgrow="ALWAYS">
            <items>
                <GUIRenderer fx:id="conversation" />
                <VBox fx:id="inputArea">
                    <children>
                        <HBox fx:id="promptRow" spacing="10.0" styleClass="prompt-row" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
                            <children>
                                <StackPane fx:id="radialSlot" styleClass="radial-slot" />
                                <TextArea fx:id="prompt" promptText="Type a prompt..." prefRowCount="4" wrapText="true" styleClass="text-normal" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
        <HBox fx:id="statusLine" styleClass="status-line" spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
            <padding>
                <Insets top="2.0" right="10.0" bottom="4.0" left="10.0" />
            </padding>
            <children>
                <Label fx:id="projectName" styleClass="text-small" />
                <Label fx:id="workingDirectory" styleClass="text-small, text-muted" textOverrun="CENTER_ELLIPSIS" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
</VBox>