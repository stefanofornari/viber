<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" styleClass="user-story-editor" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets top="10" right="10" bottom="10" left="10" />
   </padding>
   <children>
      <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab fx:id="mainTab" text="Main">
               <content>
                  <VBox>
                     <padding>
                        <Insets top="10" />
                     </padding>
                     <children>
                  <GridPane fx:id="headerForm" hgap="10" vgap="8">
                     <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <children>
                        <Label text="ID" styleClass="text-bold" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Title" styleClass="text-bold" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="titleField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="AS A" styleClass="text-bold" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <TextField fx:id="roleField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <Label text="I WANT" styleClass="text-bold" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP" />
                        <TextArea fx:id="wantArea" prefRowCount="3" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                        <Label text="SO THAT" styleClass="text-bold" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP" />
                        <TextArea fx:id="soThatArea" prefRowCount="3" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                        <Label text="Status" styleClass="text-bold" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                        <ComboBox fx:id="statusBox" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                        <Label text="Dependencies" styleClass="text-bold" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                        <TextField fx:id="dependenciesField" promptText="US-000001, US-000002" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                     </children>
                  </GridPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab fx:id="criteriaTab" text="Acceptance criteria">
               <content>
                  <VBox fx:id="criteriaForm">
                     <padding>
                        <Insets top="10" />
                     </padding>
                     <children>
                  <HBox alignment="CENTER_RIGHT">
                     <padding>
                        <Insets bottom="6" />
                     </padding>
                     <children>
                        <Button fx:id="addScenarioButton" styleClass="flat, button-circle, button-icon">
                           <graphic><FontIcon iconLiteral="fth-plus" /></graphic>
                           <tooltip><Tooltip text="Add scenario" /></tooltip>
                        </Button>
                     </children>
                  </HBox>
                  <ScrollPane fx:id="scenarioScroll" fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="250" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="scenarioBox" spacing="4" />
                     </content>
                  </ScrollPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab fx:id="notesTab" text="Notes">
               <content>
                  <VBox fx:id="notesForm" spacing="6">
                     <padding>
                        <Insets top="10" />
                     </padding>
                     <children>
                        <Label text="Technical context" styleClass="text-bold" />
                        <TextArea fx:id="technicalContextArea" wrapText="true" VBox.vgrow="ALWAYS" />
                        <Label text="Notes" styleClass="text-bold" />
                        <TextArea fx:id="notesArea" wrapText="true" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </children>
</fx:root>
